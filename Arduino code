#include <Servo.h>

// ============================================================
//                  MOTOR PIN CONFIGURATION
// ============================================================

#define ENA 10
#define IN1 9
#define IN2 8

#define IN3 7
#define IN4 6
#define ENB 5


// ============================================================
//                  SENSOR CONFIGURATION
// ============================================================

#define LEFT_SENSOR  A0
#define RIGHT_SENSOR A1

#define TRIG_PIN A3
#define ECHO_PIN A2

#define SERVO_PIN A5


// ============================================================
//                  ROBOT PARAMETERS
// ============================================================

const int BASE_SPEED = 200;
const int TURN_SPEED = 180;

const int OBSTACLE_DISTANCE = 15;
const int MAX_DISTANCE = 100;

const int LINE_DELAY = 5;

const int SERVO_CENTER = 70;
const int SERVO_LEFT   = 10;
const int SERVO_RIGHT  = 130;


// ============================================================
//                  TIMING PARAMETERS
// ============================================================

const unsigned long SERVO_SETTLE_TIME = 250;

const unsigned long TURN_TIME = 400;
const unsigned long FORWARD_TIME = 500;


// ============================================================
//                  GLOBAL VARIABLES
// ============================================================

Servo scanServo;

int frontDistance = MAX_DISTANCE;
int leftDistance  = MAX_DISTANCE;
int rightDistance = MAX_DISTANCE;

bool leftSensor;
bool rightSensor;


// ============================================================
//                  SETUP
// ============================================================

void setup()
{
    Serial.begin(9600);

    // ---------------- Sensors ----------------

    pinMode(LEFT_SENSOR, INPUT);
    pinMode(RIGHT_SENSOR, INPUT);

    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);


    // ---------------- Motors ----------------

    pinMode(ENA, OUTPUT);
    pinMode(ENB, OUTPUT);

    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);

    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);


    // ---------------- Servo ----------------

    scanServo.attach(SERVO_PIN);

    scanServo.write(SERVO_CENTER);


    // ---------------- Initial Motor State ----------------

    stopRobot();

    setMotorSpeed(BASE_SPEED, BASE_SPEED);

    delay(500);

    Serial.println("Robot Ready");
}


// ============================================================
//                  MAIN LOOP
// ============================================================

void loop()
{
    // Read line sensors
    readLineSensors();

    // Measure front distance
    frontDistance = getDistance();


    // Debug information
    printSensorData();


    // ========================================================
    //              LINE FOLLOWING + OBSTACLE
    // ========================================================

    if (!leftSensor && !rightSensor)
    {
        // Both sensors indicate line

        if (frontDistance > OBSTACLE_DISTANCE)
        {
            moveForward();
        }
        else
        {
            avoidObstacle();
        }
    }

    else if (leftSensor && !rightSensor)
    {
        // Line detected on left

        turnLeft();
    }

    else if (!leftSensor && rightSensor)
    {
        // Line detected on right

        turnRight();
    }

    else
    {
        // Both sensors detect line

        stopRobot();
    }

    delay(LINE_DELAY);
}


// ============================================================
//                  READ LINE SENSORS
// ============================================================

void readLineSensors()
{
    leftSensor = digitalRead(LEFT_SENSOR);
    rightSensor = digitalRead(RIGHT_SENSOR);
}


// ============================================================
//                  ULTRASONIC DISTANCE
// ============================================================

int getDistance()
{
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);

    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);

    digitalWrite(TRIG_PIN, LOW);


    unsigned long duration =
        pulseIn(ECHO_PIN, HIGH, 25000);


    // No echo received
    if (duration == 0)
    {
        return MAX_DISTANCE;
    }


    int distance = duration / 58;


    // Limit maximum distance
    if (distance > MAX_DISTANCE)
    {
        distance = MAX_DISTANCE;
    }


    return distance;
}


// ============================================================
//                  SERVO SCANNING
// ============================================================

int scanAtAngle(int angle)
{
    scanServo.write(angle);

    delay(SERVO_SETTLE_TIME);

    return getDistance();
}


// ============================================================
//                  OBSTACLE AVOIDANCE
// ============================================================

void avoidObstacle()
{
    Serial.println("Obstacle detected!");

    // Stop immediately
    stopRobot();

    delay(100);


    // --------------------------------------------------------
    // Scan right
    // --------------------------------------------------------

    rightDistance = scanAtAngle(SERVO_RIGHT);

    Serial.print("Right Distance: ");
    Serial.println(rightDistance);


    // --------------------------------------------------------
    // Scan left
    // --------------------------------------------------------

    leftDistance = scanAtAngle(SERVO_LEFT);

    Serial.print("Left Distance: ");
    Serial.println(leftDistance);


    // Return servo to center
    scanServo.write(SERVO_CENTER);

    delay(100);


    // --------------------------------------------------------
    // Choose direction
    // --------------------------------------------------------

    if (leftDistance > rightDistance)
    {
        Serial.println("Turning LEFT");

        performLeftAvoidance();
    }
    else
    {
        Serial.println("Turning RIGHT");

        performRightAvoidance();
    }
}


// ============================================================
//                  LEFT AVOIDANCE
// ============================================================

void performLeftAvoidance()
{
    turnLeft();

    delay(TURN_TIME);


    moveForward();

    delay(FORWARD_TIME);


    turnRight();

    delay(TURN_TIME);


    stopRobot();
}


// ============================================================
//                  RIGHT AVOIDANCE
// ============================================================

void performRightAvoidance()
{
    turnRight();

    delay(TURN_TIME);


    moveForward();

    delay(FORWARD_TIME);


    turnLeft();

    delay(TURN_TIME);


    stopRobot();
}


// ============================================================
//                  MOTOR SPEED CONTROL
// ============================================================

void setMotorSpeed(int leftSpeed, int rightSpeed)
{
    leftSpeed  = constrain(leftSpeed, 0, 255);
    rightSpeed = constrain(rightSpeed, 0, 255);

    analogWrite(ENA, leftSpeed);
    analogWrite(ENB, rightSpeed);
}


// ============================================================
//                  MOTOR CONTROL
// ============================================================

void motorControl(
    bool leftForward,
    bool leftBackward,
    bool rightForward,
    bool rightBackward)
{
    digitalWrite(IN1, leftForward);
    digitalWrite(IN2, leftBackward);

    digitalWrite(IN3, rightForward);
    digitalWrite(IN4, rightBackward);
}


// ============================================================
//                  MOVEMENT FUNCTIONS
// ============================================================

void moveForward()
{
    setMotorSpeed(BASE_SPEED, BASE_SPEED);

    motorControl(
        LOW, HIGH,
        HIGH, LOW
    );
}


// ============================================================
//                  MOVE BACKWARD
// ============================================================

void moveBackward()
{
    setMotorSpeed(BASE_SPEED, BASE_SPEED);

    motorControl(
        HIGH, LOW,
        LOW, HIGH
    );
}


// ============================================================
//                  TURN LEFT
// ============================================================

void turnLeft()
{
    setMotorSpeed(TURN_SPEED, TURN_SPEED);

    motorControl(
        HIGH, LOW,
        HIGH, LOW
    );
}


// ============================================================
//                  TURN RIGHT
// ============================================================

void turnRight()
{
    setMotorSpeed(TURN_SPEED, TURN_SPEED);

    motorControl(
        LOW, HIGH,
        LOW, HIGH
    );
}


// ============================================================
//                  STOP ROBOT
// ============================================================

void stopRobot()
{
    motorControl(
        LOW, LOW,
        LOW, LOW
    );

    analogWrite(ENA, 0);
    analogWrite(ENB, 0);
}


// ============================================================
//                  DEBUG INFORMATION
// ============================================================

void printSensorData()
{
    Serial.print("L: ");
    Serial.print(leftSensor);

    Serial.print(" | R: ");
    Serial.print(rightSensor);

    Serial.print(" | Front: ");
    Serial.print(frontDistance);

    Serial.println(" cm");
}
