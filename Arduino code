#include <Servo.h>

// ============================================================
//                    PIN CONFIGURATION
// ============================================================

// Motor driver
const byte ENA = 10;
const byte IN1 = 9;
const byte IN2 = 8;

const byte IN3 = 7;
const byte IN4 = 6;
const byte ENB = 5;

// IR sensors
const byte LEFT_SENSOR  = A0;
const byte RIGHT_SENSOR = A1;

// Ultrasonic
const byte TRIG_PIN = A3;
const byte ECHO_PIN = A2;

// Servo
const byte SERVO_PIN = A5;


// ============================================================
//                    SPEED SETTINGS
// ============================================================

const byte MAX_SPEED       = 220;
const byte BASE_SPEED      = 190;
const byte TURN_SPEED      = 175;
const byte SHARP_TURN      = 210;
const byte SLOW_SPEED      = 130;


// ============================================================
//                    DISTANCE SETTINGS
// ============================================================

const byte OBSTACLE_DISTANCE = 15;
const byte WARNING_DISTANCE  = 25;
const byte MAX_DISTANCE      = 100;


// ============================================================
//                    SERVO SETTINGS
// ============================================================

const byte SERVO_CENTER = 70;
const byte SERVO_LEFT   = 10;
const byte SERVO_RIGHT  = 130;


// ============================================================
//                    TIMING SETTINGS
// ============================================================

const unsigned long SENSOR_INTERVAL = 20;
const unsigned long DISTANCE_INTERVAL = 60;

const unsigned long SERVO_SETTLE = 180;

const unsigned long TURN_TIME = 350;
const unsigned long FORWARD_TIME = 450;

const unsigned long LOST_LINE_TIME = 250;

const unsigned long STUCK_TIME = 1200;


// ============================================================
//                    DEBUG
// ============================================================

const bool DEBUG = false;


// ============================================================
//                    SERVO OBJECT
// ============================================================

Servo scanServo;


// ============================================================
//                    ROBOT STATE
// ============================================================

enum RobotState
{
    LINE_FOLLOWING,
    STOPPING,
    SCAN_RIGHT,
    SCAN_LEFT,
    DECIDE_DIRECTION,
    AVOID_TURN_1,
    AVOID_FORWARD,
    AVOID_TURN_2,
    RECOVER
};

RobotState state = LINE_FOLLOWING;


// ============================================================
//                    MOTOR STATE
// ============================================================

enum MotorState
{
    STOPPED,
    FORWARD,
    LEFT,
    RIGHT,
    BACKWARD
};

MotorState motorState = STOPPED;


// ============================================================
//                    VARIABLES
// ============================================================

bool leftSensor;
bool rightSensor;

int frontDistance = MAX_DISTANCE;
int leftDistance  = MAX_DISTANCE;
int rightDistance = MAX_DISTANCE;

int distanceBuffer[3] = {
    MAX_DISTANCE,
    MAX_DISTANCE,
    MAX_DISTANCE
};

byte distanceIndex = 0;

bool turnLeftDirection = false;

unsigned long lastSensorRead = 0;
unsigned long lastDistanceRead = 0;
unsigned long stateStartTime = 0;
unsigned long lineLostTime = 0;
unsigned long movementStartTime = 0;


// ============================================================
//                    LAST LINE DIRECTION
// ============================================================

enum LineDirection
{
    NO_DIRECTION,
    LAST_LEFT,
    LAST_RIGHT
};

LineDirection lastDirection = NO_DIRECTION;


// ============================================================
//                         SETUP
// ============================================================

void setup()
{
    if (DEBUG)
        Serial.begin(9600);

    // IR sensors
    pinMode(LEFT_SENSOR, INPUT);
    pinMode(RIGHT_SENSOR, INPUT);

    // Ultrasonic
    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);

    // Motor driver
    pinMode(ENA, OUTPUT);
    pinMode(ENB, OUTPUT);

    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);

    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);

    // Servo
    scanServo.attach(SERVO_PIN);
    scanServo.write(SERVO_CENTER);

    stopRobot();

    if (DEBUG)
        Serial.println(F("Robot Ready"));
}


// ============================================================
//                         MAIN LOOP
// ============================================================

void loop()
{
    unsigned long now = millis();

    // --------------------------------------------------------
    // Read IR sensors frequently
    // --------------------------------------------------------

    if (now - lastSensorRead >= SENSOR_INTERVAL)
    {
        lastSensorRead = now;

        readLineSensors();
    }


    // --------------------------------------------------------
    // Read ultrasonic periodically
    // --------------------------------------------------------

    if (now - lastDistanceRead >= DISTANCE_INTERVAL)
    {
        lastDistanceRead = now;

        if (state == LINE_FOLLOWING)
        {
            frontDistance = getFilteredDistance();
        }
    }


    // --------------------------------------------------------
    // Robot state machine
    // --------------------------------------------------------

    switch (state)
    {
        case LINE_FOLLOWING:
            lineFollowing();
            break;


        case STOPPING:
            obstacleStop();
            break;


        case SCAN_RIGHT:
            scanRight();
            break;


        case SCAN_LEFT:
            scanLeft();
            break;


        case DECIDE_DIRECTION:
            decideDirection();
            break;


        case AVOID_TURN_1:
            avoidanceTurn1();
            break;


        case AVOID_FORWARD:
            avoidanceForward();
            break;


        case AVOID_TURN_2:
            avoidanceTurn2();
            break;


        case RECOVER:
            recoverRobot();
            break;
    }
}


// ============================================================
//                    LINE FOLLOWING
// ============================================================

void lineFollowing()
{
    // --------------------------------------------------------
    // Obstacle detection
    // --------------------------------------------------------

    if (frontDistance <= OBSTACLE_DISTANCE)
    {
        stopRobot();

        stateStartTime = millis();

        state = STOPPING;

        return;
    }


    // --------------------------------------------------------
    // Both sensors OFF
    // --------------------------------------------------------

    if (!leftSensor && !rightSensor)
    {
        lineLostTime = millis();

        // Normal forward motion
        moveForwardAdaptive();

        return;
    }


    // --------------------------------------------------------
    // Left sensor active
    // --------------------------------------------------------

    if (leftSensor && !rightSensor)
    {
        lastDirection = LAST_LEFT;

        lineLostTime = millis();

        turnLeftAdaptive();

        return;
    }


    // --------------------------------------------------------
    // Right sensor active
    // --------------------------------------------------------

    if (!leftSensor && rightSensor)
    {
        lastDirection = LAST_RIGHT;

        lineLostTime = millis();

        turnRightAdaptive();

        return;
    }


    // --------------------------------------------------------
    // Both sensors active
    // --------------------------------------------------------

    if (leftSensor && rightSensor)
    {
        stopRobot();

        // If both sensors stay active for too long,
        // attempt recovery.
        if (millis() - lineLostTime > LOST_LINE_TIME)
        {
            state = RECOVER;
            stateStartTime = millis();
        }
    }
}


// ============================================================
//              ADAPTIVE FORWARD MOVEMENT
// ============================================================

void moveForwardAdaptive()
{
    byte speed = BASE_SPEED;

    // Slow down when approaching obstacle
    if (frontDistance <= WARNING_DISTANCE)
    {
        speed = SLOW_SPEED;
    }

    setMotorSpeed(speed, speed);

    if (motorState == FORWARD)
        return;

    motorState = FORWARD;

    motorControl(
        LOW, HIGH,
        HIGH, LOW
    );

    movementStartTime = millis();
}


// ============================================================
//                 ADAPTIVE LEFT TURN
// ============================================================

void turnLeftAdaptive()
{
    byte leftSpeed;
    byte rightSpeed;

    // Slow inside wheel for smoother turning
    leftSpeed = TURN_SPEED - 50;
    rightSpeed = TURN_SPEED;

    setMotorSpeed(leftSpeed, rightSpeed);

    if (motorState == LEFT)
        return;

    motorState = LEFT;

    motorControl(
        HIGH, LOW,
        HIGH, LOW
    );

    movementStartTime = millis();
}


// ============================================================
//                 ADAPTIVE RIGHT TURN
// ============================================================

void turnRightAdaptive()
{
    byte leftSpeed;
    byte rightSpeed;

    leftSpeed = TURN_SPEED;
    rightSpeed = TURN_SPEED - 50;

    setMotorSpeed(leftSpeed, rightSpeed);

    if (motorState == RIGHT)
        return;

    motorState = RIGHT;

    motorControl(
        LOW, HIGH,
        LOW, HIGH
    );

    movementStartTime = millis();
}


// ============================================================
//                    READ LINE SENSORS
// ============================================================

void readLineSensors()
{
    leftSensor = digitalRead(LEFT_SENSOR);
    rightSensor = digitalRead(RIGHT_SENSOR);
}


// ============================================================
//                  FILTERED DISTANCE..
// ============================================================

int getFilteredDistance()
{
    int newDistance = getDistance();

    distanceBuffer[distanceIndex] = newDistance;

    distanceIndex++;

    if (distanceIndex >= 3)
        distanceIndex = 0;

    // Sort three values
    int a = distanceBuffer[0];
    int b = distanceBuffer[1];
    int c = distanceBuffer[2];

    // Median filter
    if (a > b)
    {
        int temp = a;
        a = b;
        b = temp;
    }

    if (b > c)
    {
        int temp = b;
        b = c;
        c = temp;
    }

    if (a > b)
    {
        int temp = a;
        a = b;
        b = temp;
    }

    return b;
}


// ============================================================
//                    ULTRASONIC SENSOR
// ============================================================

int getDistance()
{
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);

    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);

    digitalWrite(TRIG_PIN, LOW);

    unsigned long duration =
        pulseIn(ECHO_PIN, HIGH, 12000UL);

    if (duration == 0)
        return MAX_DISTANCE;

    int distance = duration / 58;

    if (distance > MAX_DISTANCE)
        distance = MAX_DISTANCE;

    return distance;
}


// ============================================================
//                   OBSTACLE STOP
// ============================================================

void obstacleStop()
{
    stopRobot();

    if (millis() - stateStartTime >= 100)
    {
        scanServo.write(SERVO_RIGHT);

        stateStartTime = millis();

        state = SCAN_RIGHT;
    }
}


// ============================================================
//                    SCAN RIGHT
// ============================================================

void scanRight()
{
    if (millis() - stateStartTime >= SERVO_SETTLE)
    {
        rightDistance = getDistance();

        scanServo.write(SERVO_LEFT);

        stateStartTime = millis();

        state = SCAN_LEFT;
    }
}


// ============================================================
//                     SCAN LEFT
// ============================================================

void scanLeft()
{
    if (millis() - stateStartTime >= SERVO_SETTLE)
    {
        leftDistance = getDistance();

        scanServo.write(SERVO_CENTER);

        state = DECIDE_DIRECTION;
    }
}


// ============================================================
//                 CHOOSE BEST DIRECTION
// ============================================================

void decideDirection()
{
    // Give a small preference to the left
    // if both distances are almost equal.

    if (leftDistance >= rightDistance)
    {
        turnLeftDirection = true;
    }
    else
    {
        turnLeftDirection = false;
    }

    stateStartTime = millis();

    if (turnLeftDirection)
        turnLeftAdaptive();
    else
        turnRightAdaptive();

    state = AVOID_TURN_1;
}


// ============================================================
//                 FIRST AVOIDANCE TURN
// ============================================================

void avoidanceTurn1()
{
    if (millis() - stateStartTime >= TURN_TIME)
    {
        moveForwardAvoidance();

        stateStartTime = millis();

        state = AVOID_FORWARD;
    }
}


// ============================================================
//                   AVOIDANCE FORWARD
// ============================================================

void moveForwardAvoidance()
{
    setMotorSpeed(MAX_SPEED - 20, MAX_SPEED - 20);

    motorState = FORWARD;

    motorControl(
        LOW, HIGH,
        HIGH, LOW
    );
}


void avoidanceForward()
{
    // If another obstacle appears,
    // immediately stop and rescan.

    frontDistance = getDistance();

    if (frontDistance <= OBSTACLE_DISTANCE)
    {
        stopRobot();

        stateStartTime = millis();

        state = STOPPING;

        return;
    }


    if (millis() - stateStartTime >= FORWARD_TIME)
    {
        if (turnLeftDirection)
            turnRightAdaptive();
        else
            turnLeftAdaptive();

        stateStartTime = millis();

        state = AVOID_TURN_2;
    }
}


// ============================================================
//                 SECOND AVOIDANCE TURN
// ============================================================

void avoidanceTurn2()
{
    if (millis() - stateStartTime >= TURN_TIME)
    {
        stopRobot();

        state = LINE_FOLLOWING;

        lineLostTime = millis();
    }
}


// ============================================================
//                    LINE RECOVERY
// ============================================================

void recoverRobot()
{
    unsigned long elapsed =
        millis() - stateStartTime;


    // --------------------------------------------------------
    // Try the previous direction first
    // --------------------------------------------------------

    if (elapsed < 300)
    {
        if (lastDirection == LAST_LEFT)
        {
            turnLeftAdaptive();
        }
        else if (lastDirection == LAST_RIGHT)
        {
            turnRightAdaptive();
        }
        else
        {
            moveForward();
        }

        return;
    }


    // --------------------------------------------------------
    // If line still not found, stop
    // --------------------------------------------------------

    stopRobot();

    if (elapsed > 600)
    {
        state = LINE_FOLLOWING;
    }
}


// ============================================================
//                     MOTOR SPEED
// ============================================================

void setMotorSpeed(byte leftSpeed, byte rightSpeed)
{
    analogWrite(ENA, leftSpeed);
    analogWrite(ENB, rightSpeed);
}


// ============================================================
//                    MOTOR CONTROL
// ============================================================

void motorControl(
    bool leftForward,
    bool leftBackward,
    bool rightForward,
    bool rightBackward)
{
    digitalWrite(IN1, leftForward);
    digitalWrite(IN2, leftBackward);

    digitalWrite(IN3, rightForward);
    digitalWrite(IN4, rightBackward);
}


// ============================================================
//                    BASIC FORWARD
// ============================================================

void moveForward()
{
    setMotorSpeed(BASE_SPEED, BASE_SPEED);

    if (motorState == FORWARD)
        return;

    motorState = FORWARD;

    motorControl(
        LOW, HIGH,
        HIGH, LOW
    );
}


// ============================================================
//                     STOP ROBOT
// ============================================================

void stopRobot()
{
    if (motorState == STOPPED)
        return;

    motorState = STOPPED;

    analogWrite(ENA, 0);
    analogWrite(ENB, 0);

    motorControl(
        LOW, LOW,
        LOW, LOW
    );
}
