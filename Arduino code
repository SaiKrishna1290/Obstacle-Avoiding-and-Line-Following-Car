#include <Servo.h>

// ============================================================
//                     PIN CONFIGURATION
// ============================================================

// Motor driver
const byte ENA = 10;
const byte IN1 = 9;
const byte IN2 = 8;

const byte IN3 = 7;
const byte IN4 = 6;
const byte ENB = 5;

// Line sensors
const byte LEFT_SENSOR  = A0;
const byte RIGHT_SENSOR = A1;

// Ultrasonic sensor
const byte TRIG_PIN = A3;
const byte ECHO_PIN = A2;

// Servo
const byte SERVO_PIN = A5;


// ============================================================
//                     ROBOT PARAMETERS
// ============================================================

const byte BASE_SPEED = 200;
const byte TURN_SPEED = 180;

const byte OBSTACLE_DISTANCE = 15;
const byte MAX_DISTANCE = 100;

const byte SERVO_CENTER = 70;
const byte SERVO_LEFT   = 10;
const byte SERVO_RIGHT  = 130;

const unsigned long SERVO_SETTLE_TIME = 250;
const unsigned long TURN_TIME = 400;
const unsigned long FORWARD_TIME = 500;


// ============================================================
//                     GLOBAL OBJECT
// ============================================================

Servo scanServo;


// ============================================================
//                         SETUP
// ============================================================

void setup()
{
    Serial.begin(9600);

    // Sensors
    pinMode(LEFT_SENSOR, INPUT);
    pinMode(RIGHT_SENSOR, INPUT);

    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);

    // Motors
    pinMode(ENA, OUTPUT);
    pinMode(ENB, OUTPUT);

    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);
    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);

    // Servo
    scanServo.attach(SERVO_PIN);
    scanServo.write(SERVO_CENTER);

    stopRobot();

    Serial.println(F("Robot Ready"));
}


// ============================================================
//                       MAIN LOOP
// ============================================================

void loop()
{
    bool left  = digitalRead(LEFT_SENSOR);
    bool right = digitalRead(RIGHT_SENSOR);

    int distance = getDistance();

    /*
       Sensor logic:
       00 -> Move forward
       10 -> Turn left
       01 -> Turn right
       11 -> Stop
    */

    if (!left && !right)
    {
        if (distance > OBSTACLE_DISTANCE)
            moveForward();
        else
            avoidObstacle();
    }
    else if (left && !right)
    {
        turnLeft();
    }
    else if (!left && right)
    {
        turnRight();
    }
    else
    {
        stopRobot();
    }

    delay(5);
}


// ============================================================
//                    ULTRASONIC SENSOR
// ============================================================

int getDistance()
{
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);

    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN, LOW);

    unsigned long duration = pulseIn(ECHO_PIN, HIGH, 25000UL);

    if (duration == 0)
        return MAX_DISTANCE;

    int distance = duration / 58;

    return min(distance, MAX_DISTANCE);
}


// ============================================================
//                     SERVO SCANNING
// ============================================================

int scanAtAngle(byte angle)
{
    scanServo.write(angle);
    delay(SERVO_SETTLE_TIME);

    return getDistance();
}


// ============================================================
//                   OBSTACLE AVOIDANCE
// ============================================================

void avoidObstacle()
{
    stopRobot();

    delay(100);

    // Scan both sides
    int rightDistance = scanAtAngle(SERVO_RIGHT);
    int leftDistance  = scanAtAngle(SERVO_LEFT);

    scanServo.write(SERVO_CENTER);
    delay(100);

    // Select clearer path
    if (leftDistance > rightDistance)
    {
        performAvoidance(true);
    }
    else
    {
        performAvoidance(false);
    }
}


// ============================================================
//                    AVOIDANCE MOVEMENT
// ============================================================

void performAvoidance(bool left)
{
    if (left)
    {
        turnLeft();
        delay(TURN_TIME);

        moveForward();
        delay(FORWARD_TIME);

        turnRight();
        delay(TURN_TIME);
    }
    else
    {
        turnRight();
        delay(TURN_TIME);

        moveForward();
        delay(FORWARD_TIME);

        turnLeft();
        delay(TURN_TIME);
    }

    stopRobot();
}


// ============================================================
//                     MOTOR SPEED
// ============================================================

void setMotorSpeed(byte leftSpeed, byte rightSpeed)
{
    analogWrite(ENA, leftSpeed);
    analogWrite(ENB, rightSpeed);
}


// ============================================================
//                     MOTOR CONTROL
// ============================================================

void motorControl(
    bool leftForward,
    bool leftBackward,
    bool rightForward,
    bool rightBackward)
{
    digitalWrite(IN1, leftForward);
    digitalWrite(IN2, leftBackward);

    digitalWrite(IN3, rightForward);
    digitalWrite(IN4, rightBackward);
}


// ============================================================
//                     MOVEMENT
// ============================================================

void moveForward()
{
    setMotorSpeed(BASE_SPEED, BASE_SPEED);

    motorControl(
        LOW, HIGH,
        HIGH, LOW
    );
}


void moveBackward()
{
    setMotorSpeed(BASE_SPEED, BASE_SPEED);

    motorControl(
        HIGH, LOW,
        LOW, HIGH
    );
}


void turnLeft()
{
    setMotorSpeed(TURN_SPEED, TURN_SPEED);

    motorControl(
        HIGH, LOW,
        HIGH, LOW
    );
}


void turnRight()
{
    setMotorSpeed(TURN_SPEED, TURN_SPEED);

    motorControl(
        LOW, HIGH,
        LOW, HIGH
    );
}


void stopRobot()
{
    analogWrite(ENA, 0);
    analogWrite(ENB, 0);

    motorControl(
        LOW, LOW,
        LOW, LOW
    );
}
