#include <Servo.h>

//---------------- Motor Pins ----------------//
#define enA 10
#define in1 9
#define in2 8
#define in3 7
#define in4 6
#define enB 5

//---------------- Sensor Pins ----------------//
#define L_S A0
#define R_S A1

#define echoPin A2
#define trigPin A3

#define servoPin A5

//---------------- Constants ----------------//
const int MOTOR_SPEED = 200;
const int OBSTACLE_DISTANCE = 15;

Servo scanServo;

long distanceFront;
long distanceLeft;
long distanceRight;

//========================================================
// SETUP
//========================================================

void setup()
{
  Serial.begin(9600);

  pinMode(L_S, INPUT);
  pinMode(R_S, INPUT);

  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  pinMode(enA, OUTPUT);
  pinMode(enB, OUTPUT);

  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);

  analogWrite(enA, MOTOR_SPEED);
  analogWrite(enB, MOTOR_SPEED);

  scanServo.attach(servoPin);

  scanServo.write(70);
  delay(500);

  distanceFront = Ultrasonic_read();
}

//========================================================
// LOOP
//========================================================

void loop()
{
  bool leftSensor = digitalRead(L_S);
  bool rightSensor = digitalRead(R_S);

  distanceFront = Ultrasonic_read();

  Serial.print("Front = ");
  Serial.println(distanceFront);

  // Line detected
  if (!leftSensor && !rightSensor)
  {
    if (distanceFront > OBSTACLE_DISTANCE)
      forward();
    else
      checkSide();
  }

  else if (rightSensor && !leftSensor)
  {
    turnRight();
  }

  else if (!rightSensor && leftSensor)
  {
    turnLeft();
  }

  else
  {
    Stop();
  }

  delay(10);
}

//========================================================
// ULTRASONIC
//========================================================

long Ultrasonic_read()
{
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0)
    return 100;

  return duration / 58;
}

//========================================================
// SERVO SCAN
//========================================================

long scan(int angle)
{
  scanServo.write(angle);
  delay(300);

  return Ultrasonic_read();
}

//========================================================
// CHECK BOTH SIDES
//========================================================

void checkSide()
{
  Stop();

  delay(200);

  distanceRight = scan(140);

  Serial.print("Right = ");
  Serial.println(distanceRight);

  distanceLeft = scan(0);

  Serial.print("Left = ");
  Serial.println(distanceLeft);

  scanServo.write(70);

  compareDistance();
}

//========================================================
// DECISION
//========================================================

void compareDistance()
{
  if (distanceLeft > distanceRight)
  {
    turnLeft();
    delay(500);

    forward();
    delay(600);

    turnRight();
    delay(500);
  }
  else
  {
    turnRight();
    delay(500);

    forward();
    delay(600);

    turnLeft();
    delay(500);
  }
}

//========================================================
// MOTOR CONTROL
//========================================================

void motor(bool a, bool b, bool c, bool d)
{
  digitalWrite(in1, a);
  digitalWrite(in2, b);
  digitalWrite(in3, c);
  digitalWrite(in4, d);
}

void forward()
{
  motor(LOW, HIGH, HIGH, LOW);
}

void backward()
{
  motor(HIGH, LOW, LOW, HIGH);
}

void turnLeft()
{
  motor(HIGH, LOW, HIGH, LOW);
}

void turnRight()
{
  motor(LOW, HIGH, LOW, HIGH);
}

void Stop()
{
  motor(LOW, LOW, LOW, LOW);
}
