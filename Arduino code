#include <Servo.h>

// ============================================================
//                    PIN CONFIGURATION
// ============================================================

// Motor Driver
const byte ENA = 10;
const byte IN1 = 9;
const byte IN2 = 8;

const byte IN3 = 7;
const byte IN4 = 6;
const byte ENB = 5;

// IR Sensors
const byte LEFT_SENSOR  = A0;
const byte RIGHT_SENSOR = A1;

// Ultrasonic Sensor
const byte TRIG_PIN = A3;
const byte ECHO_PIN = A2;

// Servo
const byte SERVO_PIN = A5;


// ============================================================
//                    ROBOT PARAMETERS
// ============================================================

const byte BASE_SPEED = 200;
const byte TURN_SPEED = 180;

const byte OBSTACLE_DISTANCE = 15;
const byte MAX_DISTANCE = 100;

// Servo positions
const byte SERVO_CENTER = 70;
const byte SERVO_LEFT   = 10;
const byte SERVO_RIGHT  = 130;


// ============================================================
//                    TIMING PARAMETERS
// ============================================================

const unsigned long SENSOR_INTERVAL = 25;
const unsigned long SERVO_SETTLE_TIME = 180;

const unsigned long TURN_TIME = 400;
const unsigned long FORWARD_TIME = 500;

const unsigned long STOP_TIME = 100;


// ============================================================
//                    DEBUG CONTROL
// ============================================================

// Change to true when debugging
const bool DEBUG = false;


// ============================================================
//                    OBJECTS
// ============================================================

Servo scanServo;


// ============================================================
//                    ROBOT STATES
// ============================================================

enum RobotState
{
    FOLLOW_LINE,
    STOP_FOR_SCAN,
    SCAN_RIGHT,
    SCAN_LEFT,
    CHOOSE_DIRECTION,
    AVOID_TURN_1,
    AVOID_FORWARD,
    AVOID_TURN_2
};

RobotState state = FOLLOW_LINE;


// ============================================================
//                    GLOBAL VARIABLES
// ============================================================

bool leftSensor = false;
bool rightSensor = false;

int frontDistance = MAX_DISTANCE;
int leftDistance  = MAX_DISTANCE;
int rightDistance = MAX_DISTANCE;

bool avoidLeft = false;

unsigned long previousSensorTime = 0;
unsigned long stateStartTime = 0;


// ============================================================
//                    MOTOR STATE
// ============================================================

enum MotorAction
{
    MOTOR_STOP,
    MOTOR_FORWARD,
    MOTOR_LEFT,
    MOTOR_RIGHT
};

MotorAction currentMotor = MOTOR_STOP;


// ============================================================
//                         SETUP
// ============================================================

void setup()
{
    // Serial only when debugging
    if (DEBUG)
        Serial.begin(9600);

    // IR sensors
    pinMode(LEFT_SENSOR, INPUT);
    pinMode(RIGHT_SENSOR, INPUT);

    // Ultrasonic
    pinMode(TRIG_PIN, OUTPUT);
    pinMode(ECHO_PIN, INPUT);

    // Motor pins
    pinMode(ENA, OUTPUT);
    pinMode(ENB, OUTPUT);

    pinMode(IN1, OUTPUT);
    pinMode(IN2, OUTPUT);

    pinMode(IN3, OUTPUT);
    pinMode(IN4, OUTPUT);

    // Servo
    scanServo.attach(SERVO_PIN);
    scanServo.write(SERVO_CENTER);

    // Initial state
    stopRobot();

    delay(300);

    if (DEBUG)
        Serial.println(F("Robot Ready"));
}


// ============================================================
//                         MAIN LOOP
// ============================================================

void loop()
{
    unsigned long now = millis();

    // --------------------------------------------------------
    // Read sensors periodically
    // --------------------------------------------------------

    if (now - previousSensorTime >= SENSOR_INTERVAL)
    {
        previousSensorTime = now;

        readLineSensors();

        // Only read front distance during normal operation
        if (state == FOLLOW_LINE)
        {
            frontDistance = getDistance();
        }
    }


    // --------------------------------------------------------
    // Robot state machine
    // --------------------------------------------------------

    switch (state)
    {
        case FOLLOW_LINE:
            followLine();
            break;


        case STOP_FOR_SCAN:

            stopRobot();

            if (now - stateStartTime >= STOP_TIME)
            {
                scanServo.write(SERVO_RIGHT);

                stateStartTime = now;
                state = SCAN_RIGHT;
            }

            break;


        case SCAN_RIGHT:

            if (now - stateStartTime >= SERVO_SETTLE_TIME)
            {
                rightDistance = getDistance();

                scanServo.write(SERVO_LEFT);

                stateStartTime = now;
                state = SCAN_LEFT;
            }

            break;


        case SCAN_LEFT:

            if (now - stateStartTime >= SERVO_SETTLE_TIME)
            {
                leftDistance = getDistance();

                scanServo.write(SERVO_CENTER);

                state = CHOOSE_DIRECTION;
            }

            break;


        case CHOOSE_DIRECTION:

            if (leftDistance > rightDistance)
            {
                avoidLeft = true;
            }
            else
            {
                avoidLeft = false;
            }

            stateStartTime = now;

            if (avoidLeft)
                turnLeft();
            else
                turnRight();

            state = AVOID_TURN_1;

            break;


        case AVOID_TURN_1:

            if (now - stateStartTime >= TURN_TIME)
            {
                moveForward();

                stateStartTime = now;
                state = AVOID_FORWARD;
            }

            break;


        case AVOID_FORWARD:

            if (now - stateStartTime >= FORWARD_TIME)
            {
                if (avoidLeft)
                    turnRight();
                else
                    turnLeft();

                stateStartTime = now;
                state = AVOID_TURN_2;
            }

            break;


        case AVOID_TURN_2:

            if (now - stateStartTime >= TURN_TIME)
            {
                stopRobot();

                state = FOLLOW_LINE;
            }

            break;
    }
}


// ============================================================
//                    LINE FOLLOWING
// ============================================================

void followLine()
{
    /*
        Sensor combinations:

        00 -> Both on line
        10 -> Left sensor active
        01 -> Right sensor active
        11 -> Both active
    */

    if (!leftSensor && !rightSensor)
    {
        // Check obstacle
        if (frontDistance <= OBSTACLE_DISTANCE)
        {
            stateStartTime = millis();
            state = STOP_FOR_SCAN;
            stopRobot();
        }
        else
        {
            moveForward();
        }
    }

    else if (leftSensor && !rightSensor)
    {
        turnLeft();
    }

    else if (!leftSensor && rightSensor)
    {
        turnRight();
    }

    else
    {
        stopRobot();
    }
}


// ============================================================
//                    READ IR SENSORS
// ============================================================

void readLineSensors()
{
    leftSensor  = digitalRead(LEFT_SENSOR);
    rightSensor = digitalRead(RIGHT_SENSOR);
}


// ============================================================
//                    ULTRASONIC SENSOR
// ============================================================

int getDistance()
{
    // Trigger pulse
    digitalWrite(TRIG_PIN, LOW);
    delayMicroseconds(2);

    digitalWrite(TRIG_PIN, HIGH);
    delayMicroseconds(10);

    digitalWrite(TRIG_PIN, LOW);

    // Read echo
    unsigned long duration =
        pulseIn(ECHO_PIN, HIGH, 12000UL);

    // No echo
    if (duration == 0)
        return MAX_DISTANCE;

    // Convert to cm
    int distance = duration / 58;

    // Limit maximum
    if (distance > MAX_DISTANCE)
        distance = MAX_DISTANCE;

    return distance;
}


// ============================================================
//                    MOTOR SPEED
// ============================================================

void setMotorSpeed(byte leftSpeed, byte rightSpeed)
{
    analogWrite(ENA, leftSpeed);
    analogWrite(ENB, rightSpeed);
}


// ============================================================
//                    MOTOR CONTROL
// ============================================================

void motorControl(
    bool leftForward,
    bool leftBackward,
    bool rightForward,
    bool rightBackward)
{
    digitalWrite(IN1, leftForward);
    digitalWrite(IN2, leftBackward);

    digitalWrite(IN3, rightForward);
    digitalWrite(IN4, rightBackward);
}


// ============================================================
//                    MOVE FORWARD
// ============================================================

void moveForward()
{
    if (currentMotor == MOTOR_FORWARD)
        return;

    currentMotor = MOTOR_FORWARD;

    setMotorSpeed(BASE_SPEED, BASE_SPEED);

    motorControl(
        LOW, HIGH,
        HIGH, LOW
    );
}


// ============================================================
//                    TURN LEFT
// ============================================================

void turnLeft()
{
    if (currentMotor == MOTOR_LEFT)
        return;

    currentMotor = MOTOR_LEFT;

    setMotorSpeed(TURN_SPEED, TURN_SPEED);

    motorControl(
        HIGH, LOW,
        HIGH, LOW
    );
}


// ============================================================
//                    TURN RIGHT
// ============================================================

void turnRight()
{
    if (currentMotor == MOTOR_RIGHT)
        return;

    currentMotor = MOTOR_RIGHT;

    setMotorSpeed(TURN_SPEED, TURN_SPEED);

    motorControl(
        LOW, HIGH,
        LOW, HIGH
    );
}


// ============================================================
//                    STOP ROBOT
// ============================================================

void stopRobot()
{
    if (currentMotor == MOTOR_STOP)
        return;

    currentMotor = MOTOR_STOP;

    analogWrite(ENA, 0);
    analogWrite(ENB, 0);

    motorControl(
        LOW, LOW,
        LOW, LOW
    );
}
