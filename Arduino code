#include <Servo.h>

// ================= MOTOR PINS =================
#define ENA 10
#define IN1 9
#define IN2 8
#define IN3 7
#define IN4 6
#define ENB 5

// ================= SENSOR PINS =================
#define LEFT_SENSOR  A0
#define RIGHT_SENSOR A1

#define ECHO_PIN A2
#define TRIG_PIN A3

#define SERVO_PIN A5

// ================= CONSTANTS =================
const byte MOTOR_SPEED = 200;
const int OBSTACLE_DISTANCE = 15;

const byte SERVO_CENTER = 70;
const byte SERVO_RIGHT  = 140;
const byte SERVO_LEFT   = 0;

const unsigned long SERVO_DELAY = 250;

Servo scanServo;

int distanceFront;
int distanceLeft;
int distanceRight;


// =================================================
// SETUP
// =================================================

void setup()
{
  Serial.begin(9600);

  // Sensors
  pinMode(LEFT_SENSOR, INPUT);
  pinMode(RIGHT_SENSOR, INPUT);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  // Motor pins
  pinMode(ENA, OUTPUT);
  pinMode(ENB, OUTPUT);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // Motor speed
  analogWrite(ENA, MOTOR_SPEED);
  analogWrite(ENB, MOTOR_SPEED);

  // Servo
  scanServo.attach(SERVO_PIN);
  scanServo.write(SERVO_CENTER);

  Stop();

  delay(500);
}


// =================================================
// MAIN LOOP
// =================================================

void loop()
{
  bool left = digitalRead(LEFT_SENSOR);
  bool right = digitalRead(RIGHT_SENSOR);

  distanceFront = ultrasonicRead();

  // Debugging
  Serial.print("Front: ");
  Serial.println(distanceFront);

  // -------- LINE DETECTION --------

  // Both sensors on line
  if (!left && !right)
  {
    if (distanceFront > OBSTACLE_DISTANCE)
      forward();
    else
      checkSides();
  }

  // Right sensor detects line
  else if (right && !left)
  {
    turnRight();
  }

  // Left sensor detects line
  else if (!right && left)
  {
    turnLeft();
  }

  // Both sensors detect something
  else
  {
    Stop();
  }
}


// =================================================
// ULTRASONIC SENSOR
// =================================================

int ultrasonicRead()
{
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);

  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG_PIN, LOW);

  unsigned long duration =
      pulseIn(ECHO_PIN, HIGH, 25000);

  // No echo = assume no obstacle nearby
  if (duration == 0)
    return 100;

  return duration / 58;
}


// =================================================
// SERVO SCANNING
// =================================================

int scanDirection(byte angle)
{
  scanServo.write(angle);

  delay(SERVO_DELAY);

  return ultrasonicRead();
}


// =================================================
// CHECK LEFT AND RIGHT
// =================================================

void checkSides()
{
  Stop();
  delay(100);

  // Check right
  distanceRight = scanDirection(SERVO_RIGHT);

  Serial.print("Right: ");
  Serial.println(distanceRight);

  // Check left
  distanceLeft = scanDirection(SERVO_LEFT);

  Serial.print("Left: ");
  Serial.println(distanceLeft);

  // Return servo to center
  scanServo.write(SERVO_CENTER);
  delay(100);

  chooseDirection();
}


// =================================================
// CHOOSE BEST DIRECTION
// =================================================

void chooseDirection()
{
  if (distanceLeft > distanceRight)
  {
    // Turn left
    turnLeft();
    delay(450);

    forward();
    delay(550);

    turnRight();
    delay(450);
  }
  else
  {
    // Turn right
    turnRight();
    delay(450);

    forward();
    delay(550);

    turnLeft();
    delay(450);
  }

  Stop();
}


// =================================================
// MOTOR CONTROL
// =================================================

void motor(bool leftA, bool leftB,
           bool rightA, bool rightB)
{
  digitalWrite(IN1, leftA);
  digitalWrite(IN2, leftB);

  digitalWrite(IN3, rightA);
  digitalWrite(IN4, rightB);
}


// =================================================
// MOVEMENT FUNCTIONS
// =================================================

void forward()
{
  motor(LOW, HIGH, HIGH, LOW);
}


void backward()
{
  motor(HIGH, LOW, LOW, HIGH);
}


void turnLeft()
{
  motor(HIGH, LOW, HIGH, LOW);
}


void turnRight()
{
  motor(LOW, HIGH, LOW, HIGH);
}


void Stop()
{
  motor(LOW, LOW, LOW, LOW);
}
